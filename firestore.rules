rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "yubami1011@gmail.com";
    }

    match /{singleCollection}/{document} {
      allow read: if singleCollection in ["home", "profile"];
      allow create, update, delete: if singleCollection in ["home", "profile"] && isAdmin();
    }

    match /{collection}/{document} {
      allow read: if collection in [
        "songs", "notices", "schedules", "wardrobe",
        "instagram", "curiosity", "embers"
      ];
      allow create, update, delete: if isAdmin();
    }
  }
}
